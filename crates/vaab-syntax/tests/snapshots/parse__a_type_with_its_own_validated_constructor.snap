---
module
  type Email
    field address
      type Text
    to new
      parameter address
        type Text
      returns
        or fails
          ok
            type Email
          error
            type EmailError
      block
        if
          condition
            unary not
              call
                callee
                  member .contains
                    name address
                argument
                  text
                    literal "@"
          then
            block
              return
                failure
                  member .Invalid
                    name EmailError
        return
          success
            call
              callee
                member .raw
                  name Email
              argument address:
                name address
