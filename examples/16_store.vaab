# Embedded key-value store.
#
# Run with: vaab run examples/16_store.vaab
#
# `StoreError` is built-in — no need to declare it.

open_store() returns Store or fails StoreError {
    return Store.open("16_cache.vaab.kv")
}

match open_store() {
    when success store then {
        match store.set("greeting", "hello") {
            when success _ then print("wrote greeting")
            when failure error then match error {
                when Failed(message) then print("set failed: {message}")
            }
        }
        match store.get("greeting") {
            when found value then print("got: {value}")
            when nothing then print("missing")
        }
    }
    when failure error then match error {
        when Failed(message) then print("open failed: {message}")
    }
}
