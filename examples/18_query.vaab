# Fluent AREL-style Query over Db and Store.
#
# English filters: `.where("owner").is("ada")` or `.equals("owner", "ada")`.
# `DbError` / `StoreError` are built-in.
#
# Run with:
#   cargo run -p vaab-cli --bin vaab -- run examples/18_query.vaab

# `try` hands each failure straight back, so the happy path stays flat.
demo_db() returns Text or fails DbError {
    let db = try Db.connect("sqlite::memory:")
    let empty: [Text] = []
    try db.execute(
        "create table tasks (id text primary key, title text not null, owner text not null)",
        empty,
    )
    try db.from("tasks").insert({"id": "1", "title": "ship query", "owner": "ada"})
    try db.from("tasks").insert({"id": "2", "title": "rest", "owner": "ada"})
    try db.from("tasks").insert({"id": "3", "title": "other", "owner": "grace"})

    let rows = try db
        .from("tasks")
        .where("owner").is("ada")
        .order_desc("id")
        .all()
    print("ada has {rows.count} tasks")

    let found_row = try db.from("tasks").equals("id", "1").first()
    match found_row {
        when found row then {
            let title = row.get("title") otherwise "?"
            print("first title is {title}")
        }
        when nothing then print("missing row")
    }
    return "ok"
}

demo_store() returns Text or fails StoreError {
    let store = try Store.open("18_query_demo.vaab.kv")
    try store.from("session:").insert({"key": "session:ada", "value": "signed-in"})
    try store.from("session:").insert({"key": "session:grace", "value": "signed-in"})
    try store.from("other:").insert({"key": "other:x", "value": "nope"})

    let rows = try store.from("session:").equals("value", "signed-in").all()
    print("sessions: {rows.count}")
    return "ok"
}

match demo_db() {
    when success _ then {}
    when failure error then match error {
        when Failed(message) then print("db failed: {message}")
    }
}

match demo_store() {
    when success _ then {}
    when failure error then match error {
        when Failed(message) then print("store failed: {message}")
    }
}

print("done")
