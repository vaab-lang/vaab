# Vaab has no null and no exceptions.
#
# A value that might be absent is `maybe T`, which is `found x` or `nothing`.
# A result that might fail is `T or fails E`, which is `success x` or `failure e`.
# `FileError` is built-in — no need to declare it.

type Config {
    name: Text
}

first_of(items: [T]) returns maybe T {
    if items.is_empty { return nothing }
    return found items[0]
}

# `try` hands the failure straight back to the caller, so the happy path stays flat.
# In a fallible function, `return x` means success; `fail e` means failure.
read_config(path: Text) returns Config or fails FileError {
    let text = try File.read(path)
    return Config.new(name: text)
}

let ages = {"Ada": 36, "Alan": 41}

match ages.get("Ada") {
    when found value then print("Ada is {value}")
    when nothing     then print("unknown")
}

# `otherwise` supplies a fallback, turning a `maybe` into a plain value.
let safe = ages.get("Grace") otherwise 0
print(safe)

match first_of([1, 2, 3]) {
    when found n then print("starts with {n}")
    when nothing then print("empty")
}
