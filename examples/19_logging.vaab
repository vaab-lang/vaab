# Logging for HTTP services and anything else that needs a real logger.
#
# Run with: vaab serve examples/19_logging.vaab
#
# No setup needed: `log.info(...)` uses the process default (stderr, info, text).
# Override with VAAB_LOG_LEVEL and VAAB_LOG_FORMAT.
#
# Destinations when you care: Logger.stdout(), .stderr(), .file(path), .memory(), .multi([...])

choice ApiError {
    NotFound
}

log.info("server starting")

serve on port 8080 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    route get "/hello" {
        log.debug("hello route")
        reply with "hello"
    }

    route get "/boom" {
        log.error("something went wrong on purpose")
        reply with "boom" status 500
    }
}
