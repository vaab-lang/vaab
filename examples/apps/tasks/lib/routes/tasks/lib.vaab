cast TasksRoute {
    factory list(who: User or fails AuthError) returns [{Text: Text}] or fails ApiError {
        let user = try Auth.require_user(who)
        let db = try Database.open()
        try Database.ensure_schema(db)
        return Database.tasks_for(db, user.id)
    }

    factory create(who: User or fails AuthError, body: NewTask) returns Task or fails ApiError {
        let user = try Auth.require_user(who)
        if body.title.is_empty {
            fail ApiError.BadRequest("title is required")
        }
        let db = try Database.open()
        try Database.ensure_schema(db)
        let id = "{now()}"
        try Database.insert_task(db, id, body.title, user.id)
        return Task.new(id: id, title: body.title, owner: user.id)
    }
}
