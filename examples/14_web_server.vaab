# A small HTTP API in Vaab.
# Run with: vaab serve examples/14_web_server.vaab

choice ApiError {
    NotFound
}

let log = Logger.stderr()
log.set_format("text")

serve on port 8080 {
    before every request {
        log.info("{request.method} {request.path}")
    }

    route get "/hello" {
        reply with "hello"
    }

    when anything fails with ApiError as error {
        reply explain(error)
    }
}
