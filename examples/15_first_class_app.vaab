# First-class app I/O with casts — single-file version for CI.
#
# Multi-file layout with one cast per route: examples/apps/tasks/
# Stdlib errors (EnvError, DbError, AuthError, HttpError) are built-in.
#
# Run with:
#   AUTH_SECRET=dev cargo run -p vaab-cli -- serve examples/15_first_class_app.vaab

choice ApiError {
    Unauthorized
    BadRequest(message: Text)
    Database(message: Text)
}

type User {
    id: Text
    email: Text
}

type Task {
    id: Text
    title: Text
    owner: Text
}

type OkResponse {
    ok: Bool
}

type NewTask {
    title: Text
}

cast Database {
    factory path() returns Text {
        return "sqlite:examples/tasks.db"
    }

    factory open() returns Db or fails ApiError {
        match Db.connect(Database.path()) {
            when success db then { return db }
            when failure error then match error {
                when Failed(message) then { fail ApiError.Database(message) }
            }
        }
    }

    factory ensure_schema(db: Db) returns Int or fails ApiError {
        let empty: [Text] = []
        match db.execute(
            "create table if not exists tasks (id text primary key, title text not null, owner text not null)",
            empty,
        ) {
            when success count then { return count }
            when failure error then match error {
                when Failed(message) then { fail ApiError.Database(message) }
            }
        }
    }

    factory query(db: Db, sql: Text, args: [Text]) returns [{Text: Text}] or fails ApiError {
        match db.query(sql, args) {
            when success rows then { return rows }
            when failure error then match error {
                when Failed(message) then { fail ApiError.Database(message) }
            }
        }
    }

    factory execute(db: Db, sql: Text, args: [Text]) returns Int or fails ApiError {
        match db.execute(sql, args) {
            when success count then { return count }
            when failure error then match error {
                when Failed(message) then { fail ApiError.Database(message) }
            }
        }
    }
}

cast Auth {
    factory require_user(who: User or fails AuthError) returns User or fails ApiError {
        match who {
            when success user then { return user }
            when failure _ then { fail ApiError.Unauthorized }
        }
    }
}

cast HealthRoute {
    factory handle() returns OkResponse {
        return OkResponse.new(ok: yes)
    }
}

cast TasksRoute {
    factory list(who: User or fails AuthError) returns [{Text: Text}] or fails ApiError {
        let user = try Auth.require_user(who)
        let db = try Database.open()
        try Database.ensure_schema(db)
        return Database.query(
            db,
            "select id, title, owner from tasks where owner = $1 order by id desc",
            [user.id],
        )
    }

    factory create(who: User or fails AuthError, body: NewTask) returns Task or fails ApiError {
        let user = try Auth.require_user(who)
        if body.title.is_empty {
            fail ApiError.BadRequest("title is required")
        }
        let db = try Database.open()
        try Database.ensure_schema(db)
        let id = "{now()}"
        try Database.execute(
            db,
            "insert into tasks(id, title, owner) values ($1, $2, $3)",
            [id, body.title, user.id],
        )
        return Task.new(id: id, title: body.title, owner: user.id)
    }
}

serve on port 8090 {
    route get "/health" {
        reply with HealthRoute.handle()
    }

    route get "/tasks" {
        reply with try TasksRoute.list(request.who)
    }

    route post "/tasks" expecting NewTask as body {
        reply with try TasksRoute.create(request.who, body) status 201
    }

    when anything fails with ApiError as error {
        reply explain(error)
    }
}
